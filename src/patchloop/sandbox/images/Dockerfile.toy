# The toy repository used for demos, integration tests and the MCP server demo.
# Build context is toy_repo/.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 agent \
 && pip install --no-cache-dir pytest==9.1.1

COPY --chown=agent:agent . /workspace
RUN cd /workspace \
 && git init -q \
 && git -c user.name=patchloop -c user.email=patchloop@localhost add -A \
 && git -c user.name=patchloop -c user.email=patchloop@localhost commit -qm toy \
 && chown -R agent:agent /workspace

ENV PYTHONPATH=/workspace \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    PIP_NO_INDEX=1
WORKDIR /workspace
USER agent
