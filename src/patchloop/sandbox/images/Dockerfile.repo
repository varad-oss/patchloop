# One image per target repository: python:3.12-slim + pytest + the repo at a pinned commit.
# Network is used only here, at build time. Episode containers run with --network none.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 agent \
 && pip install --no-cache-dir pytest==9.1.1

ARG REPO_URL
ARG COMMIT
RUN git init -q /workspace \
 && cd /workspace \
 && git remote add origin "$REPO_URL" \
 && git fetch -q --depth 1 origin "$COMMIT" \
 && git checkout -q FETCH_HEAD \
 && chown -R agent:agent /workspace

# No install step: the packages are imported straight from /workspace, so edits take effect immediately.
ENV PYTHONPATH=/workspace \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    PIP_NO_INDEX=1
WORKDIR /workspace
USER agent
